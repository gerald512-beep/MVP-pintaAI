# Select one provider: openai, qwen, seedream, zhipu
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1

# OpenAI (optional baseline)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-image-1
OPENAI_QUALITY=medium

# Alibaba DashScope / Qwen image editing
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# Use this only if your workspace requires a region-specific endpoint:
# DASHSCOPE_ENDPOINT=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_MODEL=qwen-image-2.0-pro

# Volcengine Ark / Seedream
ARK_API_KEY=your_ark_api_key_here
ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
SEEDREAM_MODEL=doubao-seedream-5-0-lite-260628

# Zhipu AI / GLM image generation
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_ENDPOINT=https://api.z.ai/api/paas/v4/images/generations
ZHIPU_MODEL=glm-image
